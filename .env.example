# 실제 .env는 서버에만 존재 — 절대 commit 금지.
# 로컬에서 npm run dev로 호스트 직접 실행 시에는 호스트(postgres)를 localhost로 변경.
DATABASE_URL=postgresql://jerome:change_me@postgres:5432/kanban
SESSION_SECRET=replace_with_a_long_random_secret

# 회원가입 시 입력해야 하는 공유 시크릿. 충분히 어려운 임의 문자열로 설정.
SIGNUP_CODE=replace_with_signup_code

# 첫 배포 시 jerome admin 계정을 부트스트랩할 비밀번호.
# 부트스트랩 완료 후에는 비워두거나 제거 권장.
ADMIN_PASSWORD=set_only_for_initial_bootstrap

ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# NODE_ENV은 HTTPS 도입 후 docker-compose에서 production으로 설정.
